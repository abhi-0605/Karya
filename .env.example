# Database
DATABASE_URL=postgresql+asyncpg://karya:karya@localhost:5432/karyaos
REDIS_URL=redis://localhost:6379/0

# LLM Provider (LiteLLM)
LLM_PROVIDER=gemini                  # gemini | openai | ollama | fake
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=gemini/gemini-1.5-flash
ESCALATION_MODEL=gemini/gemini-1.5-pro
LLM_CONFIDENCE_THRESHOLD=0.75

# Auth (demo JWT)
JWT_SECRET=change-me-in-production-32-chars-min
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# App
APP_ENV=development
LOG_LEVEL=INFO
MOCK_API_BASE_URL=http://localhost:8001

# Mock failure modes (for demo)
MOCK_IT_FAIL_MODE=none        # none | 503 | timeout
MOCK_ADMIN_FAIL_MODE=none
MOCK_PAYROLL_FAIL_MODE=none

# Slack (optional)
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-token

# Cost (INR, used by cost meter)
INFRA_COST_PER_HOUR_INR=50.0
ESTIMATED_WORKFLOWS_PER_HOUR=20
